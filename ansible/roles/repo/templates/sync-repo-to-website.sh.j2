#!/bin/bash
# Auto-sync repository from {{ sync_source_host }} to {{ sync_dest_host }}
# Scheduled via systemd timer
# Generated by Ansible - do not edit manually

set -e

REPO_DOMAIN="{{ repo_domain }}"
SOURCE_HOST="{{ sync_source_host }}"
DEST_HOST="{{ sync_dest_host }}"
LOGFILE="/var/log/repo-sync.log"

log_msg() {
    local msg="$1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [${REPO_DOMAIN}] ${msg}" | tee -a "${LOGFILE}"
}

log_msg "Starting repository synchronization..."

# Create archive on source
log_msg "Creating repository archive on ${SOURCE_HOST}..."
ssh "${SOURCE_HOST}" "cd /var/www/html && tar czf /tmp/${REPO_DOMAIN}.tar.gz --exclude='.*' ${REPO_DOMAIN}/" \
    || { log_msg "ERROR: Failed to create archive"; exit 1; }

# Transfer to destination
log_msg "Transferring to ${DEST_HOST}..."
scp -p "${SOURCE_HOST}:/tmp/${REPO_DOMAIN}.tar.gz" /tmp/ \
    || { log_msg "ERROR: Failed to transfer archive"; exit 1; }

# Extract on destination
log_msg "Extracting archive on ${DEST_HOST}..."
scp -p "/tmp/${REPO_DOMAIN}.tar.gz" "${DEST_HOST}:/tmp/" \
    || { log_msg "ERROR: Failed to upload to destination"; exit 1; }

ssh "${DEST_HOST}" "cd /var/www/html && sudo tar xzf /tmp/${REPO_DOMAIN}.tar.gz && sudo chown -R www-data:www-data ${REPO_DOMAIN}/" \
    || { log_msg "ERROR: Failed to extract on destination"; exit 1; }

# Cleanup
log_msg "Cleaning up temporary files..."
ssh "${SOURCE_HOST}" "rm -f /tmp/${REPO_DOMAIN}.tar.gz"
ssh "${DEST_HOST}" "sudo rm -f /tmp/${REPO_DOMAIN}.tar.gz"
rm -f "/tmp/${REPO_DOMAIN}.tar.gz"

log_msg "Repository synchronization completed successfully"
