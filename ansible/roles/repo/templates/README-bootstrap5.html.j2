<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ publish_endpoint }} apt repository</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/repo.css">
</head>
<body>
  <div class="container">
    <div class="main-container">

      <!-- Header -->
      <div class="header-section">
        <div class="header-content">
          <h1><span class="vs-prompt">&gt;_</span> {{ publish_endpoint }} repository</h1>
          <div class="header-meta">
            <i class="bi bi-key"></i> GPG key: <a href="/KEY.gpg" class="text-white"><strong>/KEY.gpg</strong></a> &nbsp;|
            <i class="bi bi-clock"></i> Generated: {{ generated_at }}{% if semaphore_task_id %} | <i class="bi bi-gear"></i> Task: {{ semaphore_task_id }}{% endif %}
          </div>
        </div>
        {% if repo_logo is defined %}
        <div class="header-logo-wrapper">
          <img src="/repo-logo{{ repo_logo | splitext | last }}" alt="{{ publish_endpoint }} logo" class="header-logo">
        </div>
        {% endif %}
      </div>

      <!-- Content -->
      <div class="content-section">

        <!-- APT Repository Setup -->
        <div class="card mt-4 vs-setup-card">
          <div class="card-header vs-setup-header">
            <h2 class="mb-0"><i class="bi bi-gear"></i> Interactive APT Repository Setup</h2>
            <p class="mb-0 vs-card-subtitle">Configure {{ repo_keyword }} repository for your system</p>
          </div>
          <div class="card-body vs-body-pad">

            <!-- Distribution / Format selectors -->
            <div class="row mb-4">
              <div class="col-md-6">
                <label for="distroSelect" class="form-label vs-label-teal">
                  <i class="bi bi-hdd"></i> Select your distribution:
                </label>
                <select id="distroSelect" class="form-select vs-select-teal">
                  <option value="">-- Choose distribution --</option>
                  {% if distro_list is defined %}
                  {% for distro in distro_list | sort %}
                  <option value="{{ distro }}">{{ distro | title }}</option>
                  {% endfor %}
                  {% endif %}
                </select>
              </div>
              <div class="col-md-6">
                <label for="formatSelect" class="form-label vs-label-teal">
                  <i class="bi bi-file-text"></i> Configuration format:
                </label>
                <select id="formatSelect" class="form-select vs-select-teal">
                  <option value="deb822">DEB822 format (.sources) - Recommended</option>
                  <option value="legacy">Legacy format (sources.list)</option>
                </select>
              </div>
            </div>

            <!-- Component Selection -->
            <div class="row mb-4 d-none" id="componentSection">
              <div class="col-12">
                <label class="form-label vs-label-teal">
                  <i class="bi bi-folder"></i> Select components:
                </label>
                <div class="vs-card-teal">
                  <div class="row">
                    <div class="col-md-3">
                      <div class="form-check">
                        <input class="form-check-input vs-checkbox-teal" type="checkbox" id="compMain" value="main" checked>
                        <label class="form-check-label fw-medium" for="compMain">
                          <i class="bi bi-check-circle-fill text-success"></i> main <span class="badge bg-success ms-1">Required</span>
                        </label>
                      </div>
                    </div>
                    <div class="col-md-3 d-none" id="compBackportsWrapper">
                      <div class="form-check">
                        <input class="form-check-input vs-checkbox-teal" type="checkbox" id="compBackports" value="backports">
                        <label class="form-check-label" for="compBackports">
                          <i class="bi bi-clock-history vs-text-teal"></i> backports
                        </label>
                      </div>
                    </div>
                    <div class="col-md-3 d-none" id="compBorrowedWrapper">
                      <div class="form-check">
                        <input class="form-check-input vs-checkbox-teal" type="checkbox" id="compBorrowed" value="borrowed">
                        <label class="form-check-label" for="compBorrowed">
                          <i class="bi bi-box-arrow-in-down vs-text-purple"></i> borrowed
                        </label>
                      </div>
                    </div>
                    <div class="col-md-3 d-none" id="compGamesWrapper">
                      <div class="form-check">
                        <input class="form-check-input vs-checkbox-teal" type="checkbox" id="compGames" value="games">
                        <label class="form-check-label" for="compGames">
                          <i class="bi bi-controller text-warning"></i> games
                        </label>
                      </div>
                    </div>
                    <div class="col-md-3 d-none" id="compPaidWrapper">
                      <div class="form-check">
                        <input class="form-check-input vs-checkbox-teal" type="checkbox" id="compPaid" value="paid">
                        <label class="form-check-label" for="compPaid">
                          <i class="bi bi-cash-coin text-success"></i> paid
                        </label>
                      </div>
                    </div>
                  </div>
                  <small class="text-muted mt-2">
                    <i class="bi bi-info-circle"></i> Select the repository components you want to enable. The <strong>main</strong> component is always required.
                  </small>
                </div>
              </div>
            </div>

            <!-- Config Preview -->
            <div id="configPreview" class="d-none">
              <h3 class="vs-h3-teal"><i class="bi bi-key"></i> Step 1: Import the GPG Key</h3>
              <div class="vs-pos-rel">
                <pre id="gpgKeyCommand" class="vs-pre-teal"><code>sudo curl -fsSL {{ base_url }}/KEY.gpg -o /usr/share/keyrings/{{ repo_keyword }}-archive-keyring.gpg</code></pre>
                <button class="btn btn-sm btn-outline-primary vs-copy-btn" data-copy-target="gpgKeyCommand">
                  <i class="bi bi-clipboard"></i> Copy
                </button>
              </div>

              <h3 class="vs-text-teal"><i class="bi bi-file-code"></i> Step 2: <span id="configTypeTitle">Create Configuration File</span></h3>
              <p class="text-muted mb-3">
                <span id="configFilePathLabel">File path:</span> <code id="configFilePath" class="vs-inline-code"></code>
              </p>
              <div class="vs-pos-rel">
                <pre id="aptSourcesConfig" class="vs-pre-green"><code></code></pre>
                <button class="btn btn-sm btn-outline-success vs-copy-btn" data-copy-target="aptSourcesConfig">
                  <i class="bi bi-clipboard"></i> Copy
                </button>
              </div>

              <div class="alert alert-info vs-alert-teal">
                <i class="bi bi-info-circle"></i>
                <strong>Quick install command:</strong> Copy and paste this into your terminal:
                <pre id="quickInstallCmd" class="vs-quick-cmd" data-copy-target="quickInstallCmd"><code></code></pre>
              </div>

              <h3 class="vs-text-teal"><i class="bi bi-check2-circle"></i> Step 3: Update and Install</h3>
              <div class="vs-pos-rel">
                <pre id="aptUpdateCommand" class="vs-pre-teal-0"><code>sudo apt update
sudo apt install &lt;package-name&gt;</code></pre>
                <button class="btn btn-sm btn-outline-primary vs-copy-btn" data-copy-target="aptUpdateCommand">
                  <i class="bi bi-clipboard"></i> Copy
                </button>
              </div>
            </div>

            <!-- No distro selected state -->
            <div id="noDistroSelected" class="vs-no-distro">
              <i class="bi bi-arrow-up-circle vs-no-distro-icon"></i>
              <p class="vs-no-distro-text">Select your distribution above to generate customized configuration</p>
            </div>
          </div>
        </div>

        <!-- Package Browser -->
        <h2><i class="bi bi-box-seam"></i> Package Browser</h2>

        {% if package_links|length > 0 %}
          <!-- Search Bar -->
          <div class="search-section">
            <div class="row align-items-center">
              <div class="col-md-8">
                <div class="input-group">
                  <span class="input-group-text vs-search-addon">
                    <i class="bi bi-search"></i>
                  </span>
                  <input type="text" class="form-control search-input vs-search-input-r" id="packageSearch" placeholder="Search packages... (e.g., 'python3-', 'lib', 'server')">
                </div>
              </div>
              <div class="col-md-4">
                <button class="btn btn-outline-light vs-search-clear" id="clearSearchBtn">
                  <i class="bi bi-x-circle"></i> Clear
                </button>
              </div>
            </div>
            <div class="search-stats" id="searchStats">
              <i class="bi bi-info-circle"></i>
              Total packages: <span id="totalPackages">0</span> |
              Currently showing: <span id="visiblePackages">0</span>
            </div>
          </div>

          <!-- Main Distribution Tabs -->
          <ul class="nav nav-pills mb-3" id="distro-tabs" role="tablist">
            {# Build distro family lists dynamically from repos structure #}
            {% set ns = namespace(debian_list=[], ubuntu_list=[]) %}
            {% for endpoint in repos %}
              {% for ep_name, families in endpoint.items() %}
                {% if ep_name == publish_endpoint %}
                  {% for family in families %}
                    {% for family_name, suites in family.items() %}
                      {% for suite_obj in suites %}
                        {% for suite_name in suite_obj.keys() %}
                          {% if family_name == 'debian' %}
                            {% set ns.debian_list = ns.debian_list + [suite_name] %}
                          {% elif family_name == 'ubuntu' %}
                            {% set ns.ubuntu_list = ns.ubuntu_list + [suite_name] %}
                          {% endif %}
                        {% endfor %}
                      {% endfor %}
                    {% endfor %}
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endfor %}
            {% set debian_distros = package_links.keys() | list | intersect(ns.debian_list) | list %}
            {% set ubuntu_distros = package_links.keys() | list | intersect(ns.ubuntu_list) | list %}
            {% set other_distros  = package_links.keys() | list | difference(debian_distros + ubuntu_distros) | list %}

            {% if debian_distros %}
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="debian-tab" data-bs-toggle="pill" data-bs-target="#debian-content" type="button" role="tab">
                <img src="https://www.debian.org/logos/openlogo-nd.svg" alt="Debian" class="vs-distro-icon"> Debian <span class="stats-badge">{{ debian_distros|length }}</span>
              </button>
            </li>
            {% endif %}

            {% if ubuntu_distros %}
            <li class="nav-item" role="presentation">
              <button class="nav-link{% if not debian_distros %} active{% endif %}" id="ubuntu-tab" data-bs-toggle="pill" data-bs-target="#ubuntu-content" type="button" role="tab">
                <i class="bi bi-ubuntu"></i> Ubuntu <span class="stats-badge">{{ ubuntu_distros|length }}</span>
              </button>
            </li>
            {% endif %}

            {% if other_distros %}
            <li class="nav-item" role="presentation">
              <button class="nav-link{% if not debian_distros and not ubuntu_distros %} active{% endif %}" id="other-tab" data-bs-toggle="pill" data-bs-target="#other-content" type="button" role="tab">
                <i class="bi bi-globe"></i> Other <span class="stats-badge">{{ other_distros|length }}</span>
              </button>
            </li>
            {% endif %}
          </ul>

          <!-- Tab Content -->
          <div class="tab-content" id="distro-content">
            {% if other_distros %}
            <div class="tab-pane fade{% if not debian_distros and not ubuntu_distros %} show active{% endif %}" id="other-content" role="tabpanel">
              <div class="nested-tabs">
                <ul class="nav nav-pills mb-3" role="tablist">
                  {% for distro in other_distros %}{% if distro in package_links %}
                  <li class="nav-item" role="presentation">
                    <button class="nav-link{% if loop.first %} active{% endif %}" id="other-{{ distro }}-tab" data-bs-toggle="pill" data-bs-target="#other-{{ distro }}-content" type="button" role="tab">
                      {{ distro|title }} <span class="badge bg-light text-dark ms-2" data-badge-for="other-{{ distro }}-content">{{ package_links[distro]|length }}</span>
                    </button>
                  </li>
                  {% endif %}{% endfor %}
                </ul>
                <div class="tab-content">
                  {% for distro in other_distros %}{% if distro in package_links %}
                  <div class="tab-pane fade{% if loop.first %} show active{% endif %}" id="other-{{ distro }}-content" role="tabpanel">
                    {% if package_links[distro]|length > 0 %}
                      <div class="package-grid">
                        {% for entry in package_links[distro] | sort(attribute='name') %}
                          {% set pkg = entry.name %}{% set component = entry.component %}
                          {% set pkgname = pkg.split('_')[0] %}
                          {% set subdir = ('lib' ~ pkgname[3:4]) if pkgname[:3] == 'lib' else pkgname[0:1] %}
                        <div class="package-item" data-package-name="{{ pkgname }}" tabindex="0">
                          <div class="package-item-body">
                            <img src="/imgdeb/{{ pkgname }}.png" class="package-icon" alt="{{ pkgname }} icon">
                            <span class="package-name">{{ pkg }}</span>{% if component != 'main' %} <span class="badge bg-secondary ms-1 vs-badge-xs">{{ component }}</span>{% endif %}
                          </div>
                          <div class="package-popup">
                            <img src="/imgdeb/{{ pkgname }}.png" class="package-popup-icon" alt="{{ pkgname }} icon">
                            <div class="package-popup-content">
                              <span class="package-popup-name">{{ pkg }}</span>
                              {% if entry.description %}
                              <p class="package-popup-desc">{{ entry.description }}</p>
                              {% endif %}
                              <div class="package-actions">
                                <a href="apt://{{ pkgname }}" class="vs-apt-btn" title="One-click install via package manager (requires apturl)"><i class="bi bi-box-arrow-in-down"></i> apt://</a>
                                <a href="{{ base_url }}/pool/{{ component }}/{{ subdir }}/{{ pkgname }}/{{ pkg }}.deb" class="vs-deb-btn" title="Download .deb package"><i class="bi bi-download"></i> .deb</a>
                                <button type="button" class="vs-copy-pkg-btn" data-copy-text="sudo apt install {{ pkgname }}" title="Copy install command to clipboard"><i class="bi bi-clipboard"></i></button>
                              </div>
                            </div>
                          </div>
                        </div>
                        {% endfor %}
                      </div>
                    {% else %}
                      <div class="empty-state"><i class="bi bi-inbox"></i><p>No packages available for {{ distro|title }}</p></div>
                    {% endif %}
                  </div>
                  {% endif %}{% endfor %}
                </div>
              </div>
            </div>
            {% endif %}

            {% if debian_distros %}
            <div class="tab-pane fade show active" id="debian-content" role="tabpanel">
              <div class="nested-tabs">
                <ul class="nav nav-pills mb-3" role="tablist">
                  {% for distro in debian_distros %}{% if distro in package_links %}
                  <li class="nav-item" role="presentation">
                    <button class="nav-link{% if loop.first %} active{% endif %}" id="{{ distro }}-tab" data-bs-toggle="pill" data-bs-target="#{{ distro }}-content" type="button" role="tab">
                      {{ distro|title }} <span class="badge bg-light text-dark ms-2" data-badge-for="{{ distro }}-content">{{ package_links[distro]|length }}</span>
                    </button>
                  </li>
                  {% endif %}{% endfor %}
                </ul>
                <div class="tab-content">
                  {% for distro in debian_distros %}{% if distro in package_links %}
                  <div class="tab-pane fade{% if loop.first %} show active{% endif %}" id="{{ distro }}-content" role="tabpanel">
                    {% if package_links[distro]|length > 0 %}
                      <div class="package-grid">
                        {% for entry in package_links[distro] | sort(attribute='name') %}
                          {% set pkg = entry.name %}{% set component = entry.component %}
                          {% set pkgname = pkg.split('_')[0] %}
                          {% set subdir = ('lib' ~ pkgname[3:4]) if pkgname[:3] == 'lib' else pkgname[0:1] %}
                        <div class="package-item" data-package-name="{{ pkgname }}" tabindex="0">
                          <div class="package-item-body">
                            <img src="/imgdeb/{{ pkgname }}.png" class="package-icon" alt="{{ pkgname }} icon">
                            <span class="package-name">{{ pkg }}</span>{% if component != 'main' %} <span class="badge bg-secondary ms-1 vs-badge-xs">{{ component }}</span>{% endif %}
                          </div>
                          <div class="package-popup">
                            <img src="/imgdeb/{{ pkgname }}.png" class="package-popup-icon" alt="{{ pkgname }} icon">
                            <div class="package-popup-content">
                              <span class="package-popup-name">{{ pkg }}</span>
                              {% if entry.description %}
                              <p class="package-popup-desc">{{ entry.description }}</p>
                              {% endif %}
                              <div class="package-actions">
                                <a href="apt://{{ pkgname }}" class="vs-apt-btn" title="One-click install via package manager (requires apturl)"><i class="bi bi-box-arrow-in-down"></i> apt://</a>
                                <a href="{{ base_url }}/pool/{{ component }}/{{ subdir }}/{{ pkgname }}/{{ pkg }}.deb" class="vs-deb-btn" title="Download .deb package"><i class="bi bi-download"></i> .deb</a>
                                <button type="button" class="vs-copy-pkg-btn" data-copy-text="sudo apt install {{ pkgname }}" title="Copy install command to clipboard"><i class="bi bi-clipboard"></i></button>
                              </div>
                            </div>
                          </div>
                        </div>
                        {% endfor %}
                      </div>
                    {% else %}
                      <div class="empty-state"><i class="bi bi-inbox"></i><p>No packages available for {{ distro|title }}</p></div>
                    {% endif %}
                  </div>
                  {% endif %}{% endfor %}
                </div>
              </div>
            </div>
            {% endif %}

            {% if ubuntu_distros %}
            <div class="tab-pane fade{% if not debian_distros %} show active{% endif %}" id="ubuntu-content" role="tabpanel">
              <div class="nested-tabs">
                <ul class="nav nav-pills mb-3" role="tablist">
                  {% for distro in ubuntu_distros %}{% if distro in package_links %}
                  <li class="nav-item" role="presentation">
                    <button class="nav-link{% if loop.first %} active{% endif %}" id="ubuntu-{{ distro }}-tab" data-bs-toggle="pill" data-bs-target="#ubuntu-{{ distro }}-content" type="button" role="tab">
                      {{ distro|title }} <span class="badge bg-light text-dark ms-2" data-badge-for="ubuntu-{{ distro }}-content">{{ package_links[distro]|length }}</span>
                    </button>
                  </li>
                  {% endif %}{% endfor %}
                </ul>
                <div class="tab-content">
                  {% for distro in ubuntu_distros %}{% if distro in package_links %}
                  <div class="tab-pane fade{% if loop.first %} show active{% endif %}" id="ubuntu-{{ distro }}-content" role="tabpanel">
                    {% if package_links[distro]|length > 0 %}
                      <div class="package-grid">
                        {% for entry in package_links[distro] | sort(attribute='name') %}
                          {% set pkg = entry.name %}{% set component = entry.component %}
                          {% set pkgname = pkg.split('_')[0] %}
                          {% set subdir = ('lib' ~ pkgname[3:4]) if pkgname[:3] == 'lib' else pkgname[0:1] %}
                        <div class="package-item" data-package-name="{{ pkgname }}" tabindex="0">
                          <div class="package-item-body">
                            <img src="/imgdeb/{{ pkgname }}.png" class="package-icon" alt="{{ pkgname }} icon">
                            <span class="package-name">{{ pkg }}</span>{% if component != 'main' %} <span class="badge bg-secondary ms-1 vs-badge-xs">{{ component }}</span>{% endif %}
                          </div>
                          <div class="package-popup">
                            <img src="/imgdeb/{{ pkgname }}.png" class="package-popup-icon" alt="{{ pkgname }} icon">
                            <div class="package-popup-content">
                              <span class="package-popup-name">{{ pkg }}</span>
                              {% if entry.description %}
                              <p class="package-popup-desc">{{ entry.description }}</p>
                              {% endif %}
                              <div class="package-actions">
                                <a href="apt://{{ pkgname }}" class="vs-apt-btn" title="One-click install via package manager (requires apturl)"><i class="bi bi-box-arrow-in-down"></i> apt://</a>
                                <a href="{{ base_url }}/pool/{{ component }}/{{ subdir }}/{{ pkgname }}/{{ pkg }}.deb" class="vs-deb-btn" title="Download .deb package"><i class="bi bi-download"></i> .deb</a>
                                <button type="button" class="vs-copy-pkg-btn" data-copy-text="sudo apt install {{ pkgname }}" title="Copy install command to clipboard"><i class="bi bi-clipboard"></i></button>
                              </div>
                            </div>
                          </div>
                        </div>
                        {% endfor %}
                      </div>
                    {% else %}
                      <div class="empty-state"><i class="bi bi-inbox"></i><p>No packages available for {{ distro|title }}</p></div>
                    {% endif %}
                  </div>
                  {% endif %}{% endfor %}
                </div>
              </div>
            </div>
            {% endif %}
          </div>
        {% else %}
          <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h3>No packages available</h3>
            <p>This repository is currently empty or packages are being processed.</p>
          </div>
        {% endif %}

      </div><!-- /content-section -->

      <!-- Footer -->
      <div class="footer-section">
        {% if repo_logo is defined %}
        <div class="d-flex justify-content-center mb-3">
          <img src="{{ base_url }}/repo-logo{{ repo_logo | splitext | last }}" alt="{{ publish_endpoint | title }} Repository Logo" class="vs-footer-logo" />
        </div>
        {% endif %}
        {% if repo_org_name is defined %}
        <h4><i class="bi bi-building"></i> About {{ repo_org_name }}</h4>
        {% endif %}
        {% if repo_org_description is defined %}
        <p class="mb-3">{{ repo_org_description }}</p>
        {% endif %}
        {% if repo_org_url is defined %}
        <div class="d-flex justify-content-center gap-4 mb-3">
          <a href="{{ repo_org_url }}" target="_blank" rel="noopener" class="text-white">
            <i class="bi bi-globe"></i> {{ repo_org_url | regex_replace('^https?://', '') }}
          </a>
        </div>
        {% endif %}
        {% if repo_badge is defined %}
        <img src="{{ base_url }}/repo-badge{{ repo_badge | splitext | last }}" alt="{{ repo_org_name | default(publish_endpoint) }} Repository Badge" class="mt-3 vs-repo-badge" />
        {% endif %}
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>

  <!-- Config data for repo.js — not executed, JSON only -->
  <script type="application/json" id="repoConfig">
  {
    "distroComponents": {{ distro_components | default({}) | tojson }},
    "baseUrl":          {{ base_url | tojson }},
    "repoKeyword":      {{ repo_keyword | tojson }}
  }
  </script>

  <script src="/repo.js"></script>
</body>
</html>
